srcdir = @srcdir@
top_srcdir = @top_srcdir@
VPATH =  @top_srcdir@
LIBS = @LIBS@
CFLAGS = @CFLAGS@ -I. -I$(srcdir) -Wall
LDFLAGS = @LDFLAGS@
CC=@CC@
DEFS=@DEFS@
EXEEXT=@EXEEXT@

qxltool: qxltool.o q40card.o
	$(CC) $(CFLAGS) $(LDFLAGS) -o qxltool qxltool.o q40card.o $(LIBS)

qxltool.o: $(srcdir)/qxltool.c $(srcdir)/qxltool.h $(srcdir)/q40card.h config.h $(srcdir)/version.h
	$(CC) $(CFLAGS) $(DEFS) -c $(srcdir)/qxltool.c

q40card.o: $(srcdir)/q40card.c $(srcdir)/q40card.h config.h
	$(CC) $(CFLAGS) $(DEFS) -c $(srcdir)/q40card.c

clean:
	-rm -f *~
	-rm -f '#*#'
	-rm -f qxltool.o q40card.o

distclean: clean
	-rm -f config.h config.status config.cache
	-rm -f qxltool$(EXEEXT)
